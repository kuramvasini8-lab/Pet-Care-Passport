# ====================================================================
# PetCare Passport - Environment Configuration Template
# ====================================================================

PORT=3000
NODE_ENV=development

# Database Configuration (MySQL 8.0+)
MYSQL_HOST=localhost
MYSQL_PORT=3366
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=petcare_passport

# Session Security
SESSION_SECRET=your_long_random_session_secret_key_here

# AI Assistant Integration (gemini or openrouter)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct

# Transactional Email (Resend HTTP API)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=PetCare Passport <notifications@petcarepassport.com>

# Initial Administrator Bootstrap (Created on initial startup if none exists)
ADMIN_BOOTSTRAP_EMAIL=admin@petcarepassport.com
ADMIN_BOOTSTRAP_PASSWORD=AdminPass123!
ADMIN_BOOTSTRAP_NAME=System Administrator
