# ====================================================================
# PetCare Passport - Environment Configuration Template
# ====================================================================

PORT=3000
NODE_ENV=development

# Database Configuration (MySQL 8.0+)
MYSQL_HOST=localhost
MYSQL_PORT=3366
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=petcare_passport

# Session Security
SESSION_SECRET=your_long_random_session_secret_key_here

# AI Assistant Integration (gemini or openrouter)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct

# Transactional Email (Resend HTTP API)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=PetCare Passport <notifications@petcarepassport.com>

# Public Base URL for Digital Pet Passports and Collar QR Code Generation
# Local Development: Defaults to http://localhost:3000 if omitted.
# Production Deployment: MANDATORY. Must use HTTPS (e.g. https://petcare.example.com).
# In production, QR codes will fail to generate if this is missing or not HTTPS.
# Configure this in your hosting platform dashboard (e.g. AWS, Render, Railway) or production .env.
PUBLIC_BASE_URL=http://localhost:3000

# Initial Administrator Bootstrap (Run: npm run bootstrap-admin)
ADMIN_BOOTSTRAP_EMAIL=admin@yourproductiondomain.com
ADMIN_BOOTSTRAP_PASSWORD=YourStrongPassword!123
ADMIN_BOOTSTRAP_NAME=Platform Administrator

