<svg xmlns="http://www.w3.org/2000/svg" width="600" height="450" viewBox="0 0 600 450">
    <defs>
      <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" style="stop-color:#f6ad55;stop-opacity:1" />
        <stop offset="100%" style="stop-color:#dd6b20;stop-opacity:1" />
      </linearGradient>
      <filter id="shadow" x="-10%" y="-10%" width="120%" height="120%">
        <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#000000" flood-opacity="0.15"/>
      </filter>
    </defs>
    <rect width="600" height="450" fill="url(#grad)" />
    <circle cx="300" cy="180" r="90" fill="#ffffff" filter="url(#shadow)" opacity="0.95"/>
    <text x="300" y="210" font-size="95" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif">🐕</text>
    <rect x="50" y="310" width="500" height="95" rx="16" fill="#ffffff" opacity="0.92" filter="url(#shadow)"/>
    <text x="300" y="348" font-size="28" font-weight="bold" fill="#1a202c" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif">Luna</text>
    <text x="300" y="380" font-size="18" font-weight="500" fill="#4a5568" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif">Golden Retriever</text>
  </svg>